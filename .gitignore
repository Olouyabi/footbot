# .gitignore for FootStat Analyzer (Python Telegram bot)
# Ignore common Python artifacts, virtual envs, logs, caches, IDE settings, and sensitive files

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
parts/
sdist/
var/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
ENV/
env/
.venv/
venv.bak/

# Environment files (may contain secrets)
.env
.env.*

# Editor and IDE directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs and databases
logs/
*.log
*.sqlite3
*.db

# Caches
.pytest_cache/
.mypy_cache/
.cache/
cache/

# Coverage reports
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Misc
*.bak
*.swp
*.tmp
~$*

# Secrets and credentials
secrets.json
credentials.json
